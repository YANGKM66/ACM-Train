#include <bits/stdc++.h>

using namespace std;

#define int long long
#define endl '\n'

int ans,n;
string p[200 + 10];
string s;
bool dp[200000 + 10] = {1};

bool check(int x)
{
	for(int i = 0; i < n; i++)
	{
		int len = p[i].size();
		if(x >= len && dp[x - len] && (p[i] == s.substr(x - len + 1,len)))
		{
			ans = x;
			return true;
		}
	}
	return false;
//return true;
}
void solve()
{
	for(string k;cin>>k,k!=".";p[n++]=k);
	string s;
	cin >> s;
	s = " " + s;
	for(int i = 1; i <= (int)s.size(); i++)
	{
		dp[i] = check(i);
	}
	
	cout << ans << endl;
}
 
signed main() 
{
	ios::sync_with_stdio(false);
	cin.tie(0), cout.tie(0);
	int tt = 1;
//	cin >> tt;
	while(tt--) solve();
	return 0;
}
